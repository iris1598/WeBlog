# ============================================================
#  WeBlog .gitignore
# ============================================================

# ---------- Gradle / Android 构建产物 ----------
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
.kotlin/
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
output-metadata.json

# ---------- 本机配置（含 SDK 路径，绝对不能提交） ----------
local.properties

# ---------- IDE ----------
# 只保留代码风格和检查规则，其余都是本机路径 / 缓存
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
*.iml
*.ipr
*.iws
out/
*.hprof
hs_err_pid*
replay_pid*

# ---------- 日志与系统文件 ----------
*.log
.DS_Store
Thumbs.db
desktop.ini

# ---------- AI 助手工作区（本地记忆 / 临时文件） ----------
.workbuddy-ai/

# ============================================================
#  关于签名文件
#  app/weblog.jks 是项目自带的调试 / 发布共用密钥，为了让 clone 之后
#  能直接 ./gradlew assembleRelease，这里【不】忽略它。
#  如果你要换成自己的正式密钥：
#    1. 替换 app/weblog.jks
#    2. 修改 app/build.gradle 里 signingConfigs 的 alias / 密码
#  注意：真实的正式发布密钥不要提交到公开仓库。
# ============================================================

# ============================================================
#  注意：下面这些是项目运行必需的二进制，请勿忽略
#    app/src/main/assets/env.tar.xz                 (43MB 终端环境)
#    app/src/main/assets/busybox
#    app/src/main/assets/libexec.so
#    app/src/main/jniLibs/arm64-v8a/libnode.so       (43MB)
#    app/src/main/jniLibs/arm64-v8a/libbusybox.so
# ============================================================
